# Server-side only. Never add your real key to source control.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# For OpenRouter, set AI_PROVIDER=openrouter and configure these instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Provider-hosted search; OpenRouter uses the paid Exa web plugin.
WEB_SEARCH=true
HOST=127.0.0.1
PORT=3000

# Allow only the bundled Android origin. Set on the HTTPS backend for Android.
# APP_ORIGIN=https://localhost
# Build-time only; public HTTPS backend origin, never an API key.
# STUDY_API_URL=https://your-study-backend.example
