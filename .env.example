# Server-side only. Never add your real key to source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OpenAI's hosted web search; no separate search key required.
WEB_SEARCH=true
HOST=127.0.0.1
PORT=3000

# Allow only the bundled Android origin. Set on the HTTPS backend for Android.
# APP_ORIGIN=https://localhost
# Build-time only; public HTTPS backend origin, never an API key.
# STUDY_API_URL=https://your-study-backend.example
