# Copy to .env beside package.json; leave this example free of credentials.
# Enter a replacement key privately in .env, then restart the server.
# Revoke any previously exposed key; never reuse it here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OpenAI's hosted web search; no separate search key required.
WEB_SEARCH=true
HOST=127.0.0.1
PORT=3000
