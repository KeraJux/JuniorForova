# Server-side only. Revoke exposed keys and generate a new OpenRouter key.
# Never add your real key to source control or client-side configuration.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# OpenRouter's web search plugin; search can incur additional charges.
WEB_SEARCH=true
HOST=127.0.0.1
PORT=3000
