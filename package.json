{
  "name": "folio-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check public/app.js && node --check scripts/build-android-web.js",
    "android:sync": "node scripts/build-android-web.js && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3"
  }
}
